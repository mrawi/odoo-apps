<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record model="ir.ui.view" id="product_template_purchase_page_groups">
        <field name="name">Product Template Purchase Page Access Groups</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="attributes">
                <attribute name="groups">custom_access_rights.detailed_access_group_cost,purchase.group_purchase_user</attribute>
            </xpath>
        </field>
    </record>
</odoo>